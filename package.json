{
  "name": "finance-workbench",
  "version": "1.0.0",
  "description": "个人理财工作台 - 多市场真实行情持仓管理桌面应用",
  "main": "electron/main.js",
  "author": "Wang Gang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "node tools/selftest.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "iconv-lite": "0.6.3",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "electron": "32.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.wanggang.financeworkbench",
    "productName": "FinanceWorkbench",
    "copyright": "Copyright (c) 2026 Wang Gang",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "FinanceWorkbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "个人理财工作台",
      "deleteAppDataOnUninstall": false
    }
  }
}
